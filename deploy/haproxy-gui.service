[Unit]
Description=haproxy-gui — web management UI for haproxy-cni
After=network.target haproxy.service
Wants=haproxy.service

[Service]
Type=simple
User=haproxy-gui
Group=haproxy
EnvironmentFile=/etc/haproxy-gui/env
ExecStart=/usr/local/bin/haproxy-gui
Restart=on-failure
RestartSec=2s

# Hardening: this process only needs its own DB/staging dir, the HAProxy
# runtime socket (via group membership on 'haproxy'), and read access to
# /etc/haproxy for the config editor and cert listing.
#
# CentOS 7 ships systemd 219. ProtectSystem=strict and ReadWritePaths=/
# ReadOnlyPaths= all need systemd 231+ and are silently ignored (with a
# warning) on this host — using them here would just be decoration that
# looks like protection but isn't. ProtectSystem=true (the older boolean
# form, systemd 214+) is what 219 actually understands: read-only /usr and
# /boot, nothing finer-grained. If this ever runs on a newer systemd, the
# stricter directives above are worth reinstating.
#
# NoNewPrivileges is deliberately NOT set: this service's whole privilege
# model is "run unprivileged, escalate only through sudo -n to the fixed
# helper scripts in deploy/sudoers.haproxy-gui" (see cfgfile.Store.SudoBin).
# NoNewPrivileges blocks setuid at the kernel level (prctl PR_SET_NO_NEW_PRIVS),
# which breaks sudo entirely regardless of sudo's own permissions — every
# apply/restart call fails with "sudo: effective uid is not 0".
ProtectSystem=true
ProtectHome=true
PrivateTmp=true

# Resource ceiling: this process shares the host with production HAProxy, so a
# runaway detector, feed refresh or AI call must never starve the load
# balancer. CPUQuota works on systemd 219 (CentOS 7). MemoryMax needs
# systemd 231 + cgroup v2 and is ignored on 219, so MemoryLimit (the older
# cgroup v1 name, still accepted by newer systemd) is what takes effect here.
CPUQuota=50%
MemoryLimit=512M

[Install]
WantedBy=multi-user.target
