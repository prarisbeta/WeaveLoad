# /etc/haproxy-gui/env — mode 600, owned by root:haproxy-gui (readable by the
# service user only via EnvironmentFile=). Never commit real values.

# --- OIDC client registered against OMS CNI SSO (https://oms.cni.net.id/sso) ---
OIDC_ISSUER_URL=https://oms.cni.net.id/sso
OIDC_CLIENT_ID=haproxy-gui
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URL=https://103.31.159.8:9443/auth/callback

# --- Listener ---
LISTEN_ADDR=127.0.0.1:9900
# false ONLY for local development over plain http://. Always true in production.
COOKIE_SECURE=true

# --- HAProxy integration (defaults already match haproxy-cni's layout) ---
# HAPROXY_SOCKET=/var/lib/haproxy/stats
# HAPROXY_BIN=/usr/sbin/haproxy
# HAPROXY_CFG=/etc/haproxy/haproxy.cfg
# STAGING_DIR=/var/lib/haproxy-gui/staging
# APPLY_SCRIPT=/usr/local/sbin/haproxy-gui-apply
# RESTART_SCRIPT=/usr/local/sbin/haproxy-gui-restart
# INSTALL_CERT_SCRIPT=/usr/local/sbin/haproxy-gui-install-cert
# REMOVE_CERT_SCRIPT=/usr/local/sbin/haproxy-gui-remove-cert
# SUDO_BIN=sudo
# SSL_DIR=/etc/haproxy/ssl

# --- First-run admin ---
# The local account "konsolgw" (Super Admin) is created only if missing. Set this
# to choose its password; if unset a random one is generated and logged once
# (journalctl -u haproxy-gui | grep "created local admin"). An existing account
# is never touched on restart.
# KONSOLGW_BOOTSTRAP_PASSWORD=

# --- App database ---
# DB_PATH=/var/lib/haproxy-gui/app.db

# --- AI analysis (optional) ---
# Powers the "AI analyze" button on incidents and security events. With no key the
# gateway answers from an offline canned analysis and sends nothing anywhere.
# With a key, the event summary (passwords/tokens redacted, client IPs included)
# is sent to the provider. Gemini wins if both are set. Responses are cached 10 min.
# KONSOLGW_GEMINI_API_KEY=
# KONSOLGW_GEMINI_MODEL=gemini-2.0-flash
# KONSOLGW_ANTHROPIC_API_KEY=
# KONSOLGW_ANTHROPIC_MODEL=
